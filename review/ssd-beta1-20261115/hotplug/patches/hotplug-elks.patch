--- a/elks/arch/i86/drivers/block/ssd-picomem.c
+++ b/elks/arch/i86/drivers/block/ssd-picomem.c
@@ -1,4 +1,4 @@
-/* PicoMEM USB SSD subdriver. One boot-attached 512-byte device.
+/* PicoMEM USB SSD subdriver. One open-session 512-byte device.
  * Whole-device access through /dev/ssd; use native ELKS filesystems and mount.
  * Requires the experimental PicoMEM 0x8e sector service, not stock firmware.
  */
@@ -75,6 +75,8 @@
     sector_t count = 0;
     int issued = 0;
 
+    if (failed)
+        return 0;
     save_flags(flags);
     clr_irq();
     previous = inb(PM_PORT + 3);
@@ -84,7 +86,7 @@
             goto done;
         previous = next;
     }
-    issued = command(0);
+    issued = command(4);        /* claim current medium; zero capacity if absent */
     if (!issued || !transfer(PM_READ, sizeof(info)))
         goto done;
     for (i = 0; i < sizeof(info); ++i)
@@ -94,13 +96,36 @@
         goto done;
     count = (sector_t)info[2] | (sector_t)info[3] << 8 |
         (sector_t)info[4] << 16 | (sector_t)info[5] << 24;
-done:
-    failed = !count;
     ssd_initialized = count != 0;
-    if (failed)
-        clear_error(issued);
     restore_flags(flags);
     return count;
+done:
+    failed = 1;
+    ssd_initialized = 0;
+    clear_error(issued);
+    restore_flags(flags);
+    return 0;
+}
+
+void ssddev_release(void)
+{
+    unsigned flags;
+    int issued;
+
+    if (failed) {
+        printk("ssd: USB not released; power cycle required\n");
+        return;
+    }
+    save_flags(flags);
+    clr_irq();
+    issued = command(3);
+    if (!issued || !wait_status(0)) {
+        failed = 1;
+        clear_error(issued);
+    }
+    restore_flags(flags);
+    if (failed)
+        printk("ssd: USB not released; power cycle required\n");
 }
 
