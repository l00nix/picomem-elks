+bool dev_pmio_do_rw(uint8_t *buffer, uint16_t size, bool isread, bool do16bit)
+{
+    // Only the byte port is implemented. All callers run on the command core.
+    if (!size || do16bit) return false;
+    if (!pm_transfer_lock)
+        pm_transfer_lock = spin_lock_instance(spin_lock_claim_unused(true));
+    uint32_t irq = spin_lock_blocking(pm_transfer_lock);
+    PM_RE_ISREAD = isread;
+    PM_TR_IS16B = false;
+    PM_TR_PTR = buffer;
+    PM_CmdDataL = size & 0xff;
+    PM_CmdDataH = size >> 8;
+    PM_TR_CNT_H = 0;
+    PM_TR_CNT_L = size;
+    PM_Status = isread ? STAT_DATA_READ : STAT_DATA_WRITE;
+    spin_unlock(pm_transfer_lock, irq);
+
+    uint32_t deadline = time_us_32() + 2000000u;
+    for (;;) {
+        irq = spin_lock_blocking(pm_transfer_lock);
+        bool complete = PM_TR_CNT_L == 0;
+        bool failed = PM_CmdReset || (int32_t)(time_us_32() - deadline) >= 0;
+        if (complete || failed) {
+            PM_TR_CNT_L = PM_TR_CNT_H = 0;
+            PM_TR_PTR = NULL;
+            PM_Status = STAT_CMDINPROGRESS;
+            spin_unlock(pm_transfer_lock, irq);
+            return complete && !failed;
+        }
+        spin_unlock(pm_transfer_lock, irq);
+        tight_loop_contents();
+    }
 }
 
