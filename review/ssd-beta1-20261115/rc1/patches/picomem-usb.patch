+// A missing data-ready event cannot be recovered by releasing an unknown byte.
+// Keep READY asserted and require a full PPC/PicoMEM power cycle.
+__force_inline __attribute__((noreturn)) void pm_payload_ready_fault(void)
+{
+    __asm volatile ("cpsid i" ::: "memory");
+    for (;;) __wfi();
+}
+
+__force_inline void pm_payload_wait_ready(void)
+{
+    unsigned polls = 4096;
+    while (!pio_interrupt_get(isa_pio, isa_bus_DATA_READY_IRQ))
+        if (!--polls) pm_payload_ready_fault();
+}
+#endif
 
