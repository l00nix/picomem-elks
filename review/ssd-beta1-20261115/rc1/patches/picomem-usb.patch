+++ b/src/pm_usb_ssd.cpp
@@ -0,0 +1,163 @@
+/* Whole-device USB bridge for an ELKS SSD subdriver.
+ * Experimental command 0x8e: 0 = geometry, 1 = read one sector, 2 = write and flush.
+ * Enabling this backend excludes the firmware's USB FatFs backend.
+ */
+#include "pico/stdlib.h"
+#include "tusb.h"
+#include "ff.h"
+#include "diskio.h"
+extern "C" {
+#include "USB_Host_Driver/usb.h"
+}
+#include "pm_gvars.h"
+#include "pm_defines.h"
+#include "dev_picomem_io.h"
+
+static uint8_t disk;
+static bool selected, fault, busy, good, write_ready, write_cache_enabled;
+static uint32_t sectors;
+static uint8_t data[516] __attribute__((aligned(4)));
+
+void tuh_msc_mount_cb(uint8_t addr)
+{
+    if (selected) return;
+    selected = true;
+    if (tuh_msc_get_block_size(addr, 0) != 512 ||
+        !(sectors = tuh_msc_get_block_count(addr, 0))) {
+        fault = true;
+        return;
+    }
+    disk = addr;
+    usb_set_status(addr, "USB SSD, %lu sectors", (unsigned long)sectors);
+}
+
+void tuh_msc_umount_cb(uint8_t addr)
+{
+    if (addr == disk) fault = true;  // This first backend does not support swaps.
+}
+
+static bool complete(uint8_t addr, const tuh_msc_complete_data_t *reply)
+{
+    good = addr == disk && reply->result == XFER_RESULT_SUCCESS &&
+        reply->actual_len == reply->user_arg &&
+        reply->csw->signature == MSC_CSW_SIGNATURE &&
+        reply->csw->tag == reply->cbw->tag &&
+        reply->csw->status == MSC_CSW_STATUS_PASSED &&
+        reply->csw->data_residue == 0;
+    busy = false;
+    return true;
+}
+
+/* A write shares one USB deadline across cache query, WRITE10 and any flush. */
+static bool wait_complete(uint32_t deadline)
+{
+    while (busy && !fault) {
+        tuh_task();
+        if ((int32_t)(time_us_32() - deadline) >= 0) return false;
+    }
+    return !fault && good;
+}
+
+static bool begin_transfer(uint32_t deadline)
+{
+    if (fault || !tuh_msc_ready(disk) ||
+        (int32_t)(time_us_32() - deadline) >= 0) return false;
+    busy = true;
+    good = false;
+    return true;
+}
+
+static bool sync_cache(uint32_t deadline)
+{
+    // IMMED=0, SYNC_NV=0, LBA/count=0: complete all cached writes to media.
+    msc_cbw_t cbw = {};
+    cbw.signature = MSC_CBW_SIGNATURE;
+    cbw.tag = 0x54555342;
+    cbw.cmd_len = 10;
+    cbw.command[0] = 0x35;       // SYNCHRONIZE CACHE(10), no DATA stage.
+    return begin_transfer(deadline) &&
+        tuh_msc_scsi_command(disk, &cbw, NULL, complete, 0) &&
+        wait_complete(deadline);
+}
+
+static bool read_sector(uint32_t lba)
+{
+    uint32_t deadline = time_us_32() + 2000000u;
+    return lba < sectors && begin_transfer(deadline) &&
+        tuh_msc_read10(disk, 0, data + 4, lba, 1, complete, 512) &&
+        wait_complete(deadline);
+}
+
+/* Require an explicit standard caching page; unknown cache policy denies writes. */
+static bool prepare_write(uint32_t deadline)
+{
+    if (write_ready) return true;
+    msc_cbw_t cbw = {};
+    cbw.signature = MSC_CBW_SIGNATURE;
+    cbw.tag = 0x54555342;
+    cbw.total_bytes = 24;
+    cbw.dir = 0x80;
+    cbw.cmd_len = 6;
+    cbw.command[0] = 0x1a;       // MODE SENSE(6), current caching page, DBD=1.
+    cbw.command[1] = 8;
+    cbw.command[2] = 8;
+    cbw.command[4] = 24;
+    uint8_t *mode = data + 4;    // Query before receiving the host's write data.
+    if (!begin_transfer(deadline) ||
+        !tuh_msc_scsi_command(disk, &cbw, mode, complete, 24) ||
+        !wait_complete(deadline)) return false;
+    if (mode[0] != 23 || mode[1] != 0 || (mode[2] & 0x80) ||
+        mode[3] != 0 || (mode[4] & 0x7f) != 8 || mode[5] != 18)
+        return false;
+    bool enabled = (mode[6] & 4) != 0;
+    if (enabled && !sync_cache(deadline)) return false;
+    write_cache_enabled = enabled;
+    write_ready = true;
+    return true;
+}
+
+static bool write_sector(uint32_t lba, uint32_t deadline)
+{
+    if (lba >= sectors) return false;
+    return begin_transfer(deadline) &&
+        tuh_msc_write10(disk, 0, data + 4, lba, 1, complete, 512) &&
+        wait_complete(deadline) &&
+        (!write_cache_enabled || sync_cache(deadline));
+}
+
+bool pm_usb_ssd_command(uint8_t operation)
+{
+    // All commands run on the USB task core. After any failure this static
+    // buffer remains reserved, even if a timed-out DMA completes much later.
+    if (fault || !disk || !tuh_msc_mounted(disk)) return false;
+    if (operation == 0) {
+        data[0] = 'P'; data[1] = 'M';
+        for (unsigned i = 0; i < 4; ++i) data[2+i] = sectors >> (8*i);
+        data[6] = 0; data[7] = 2;  // 512-byte sectors, little endian.
+        if (dev_pmio_do_rw(data, 8, true, false)) return true;
+    } else if (operation == 1 || operation == 2) {
+        uint32_t deadline = time_us_32() + 2000000u;
+        if (operation == 2 && (!prepare_write(deadline) ||
+            (int32_t)(time_us_32() - deadline) >= 0)) goto failed;
+        if (dev_pmio_do_rw(data, operation == 1 ? 4 : 516, false, false)) {
+            uint32_t lba = (uint32_t)data[0] | (uint32_t)data[1] << 8 |
+                (uint32_t)data[2] << 16 | (uint32_t)data[3] << 24;
+            if (operation == 2 ? write_sector(lba, deadline) :
+                read_sector(lba) && dev_pmio_do_rw(data + 4, 512, true, false))
+                return true;
+        }
+    }
+failed:
+    fault = true;
+    return false;
+}
+
+// Keep internal SD FatFs service intact, but never expose this raw-owned USB
+// medium to BIOS disk images, PMDFS or other firmware filesystem consumers.
+extern "C" {
+DSTATUS usb_disk_status() { return STA_NODISK; }
+DSTATUS usb_disk_initialize() { return STA_NODISK; }
+DRESULT usb_disk_read(BYTE *, LBA_t, UINT) { return RES_NOTRDY; }
+DRESULT usb_disk_write(const BYTE *, LBA_t, UINT) { return RES_NOTRDY; }
+DRESULT usb_disk_ioctl(BYTE, void *) { return RES_NOTRDY; }
+}
