+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdarg.h>
+typedef uint32_t sector_t;
+typedef uint32_t jiff_t;
+typedef unsigned kdev_t;
+typedef unsigned ramdesc_t;
+typedef unsigned flag_t;
+struct buffer_head {
+ unsigned b_dirty,b_uptodate,b_locked,b_count,b_mapcount;
+ kdev_t b_dev; uint32_t b_blocknr;
+ struct buffer_head *b_next_lru,*b_prev_lru;
+ char data[1024];
+};
+typedef struct buffer_head ext_buffer_head;
+struct request {
+ kdev_t rq_dev; unsigned char rq_cmd,rq_status;
+ sector_t rq_sector; uint16_t rq_nr_sectors; char *rq_buffer; ramdesc_t rq_seg;
+ struct buffer_head *rq_bh; struct request *rq_next; int rq_errors;
+};
+struct blk_dev_struct {void (*request_fn)(void);struct request *current_request;};
+struct inode {int unused;};struct file {int unused;};struct wait_queue {int unused;};
+struct ssd_lifecycle {unsigned flags;int (*open)(unsigned mode);void (*release)(void);};
+struct hd_struct {sector_t start_sect,nr_sects;};
+static int block_write(void) { return 0; }
+static struct { int (*write)(void); } ssd_fops = { block_write };
+#define EBH(b) (b)
+#define READ 0
+#define WRITE 1
+#define RQ_ACTIVE 1
+#define RQ_INACTIVE 0
+#define SSD_MAJOR 2
+#define MAJOR_NR SSD_MAJOR
+#define MAJOR(d) ((d)>>8)
+#define MINOR(d) ((d)&255)
+#define MKDEV(a,b) (((a)<<8)|(b))
+#define SSD_MINORS 2
+#define CONFIG_SSD_PARTITIONS 1
+#define SSD_READ_ONLY 1
+#define SD_FIXED_SECTOR_SIZE 512
+#define BLOCK_SIZE 1024
+#define CURRENT (blk_dev[SSD_MAJOR].current_request)
+#define DEVICE_OFF(d) ((void)(d))
+#define DEVICE_NAME "ssd"
+#define CHECK_REQUEST(r) assert((r)->rq_status==RQ_ACTIVE)
+#define IN_ORDER(a,b) ((a)->rq_dev<(b)->rq_dev || ((a)->rq_dev==(b)->rq_dev && (a)->rq_sector<(b)->rq_sector))
+#define FARPROC
+#define debug_blk(...) ((void)0)
+#define debug_sup(...) ((void)0)
+#define save_flags(f) ((f)=0)
+#define restore_flags(f) ((void)(f))
+#define clr_irq() ((void)0)
+#define set_irq() ((void)0)
+static struct blk_dev_struct blk_dev[3];
+#ifdef CONFIG_ASYNCIO
+static struct wait_queue wait_for_request;
+#endif
+static struct buffer_head buffers[2],*bh_lru,*bh_llru;
+static struct hd_struct ssd_part[SSD_MINORS];
+static sector_t ssd_num_sects;
+static unsigned access_count,lifecycle_busy;
+static int ssd_initialized;
+static jiff_t ssd_timeout;
+static unsigned writes,reads,fail_at,uncertain_at,errors,releases,cases;
+static unsigned char disk[16][512];
+static void do_ssd_request(void);
+static void ssd_io_complete(void);
+static void ll_rw_blk(int,struct buffer_head*);
+static void wait_on_buffer(struct buffer_head *b){assert(!b->b_locked);}
+static void wake_up(struct wait_queue *q){(void)q;}
+static void mark_buffer_clean(struct buffer_head *b){b->b_dirty=0;}
+static void brelseL1(struct buffer_head *b,int copy){(void)b;(void)copy;}
+static void invalidate_inodes(kdev_t d){(void)d;}
+static void sync_supers(kdev_t d){(void)d;}
+static void sync_inodes(kdev_t d){(void)d;}
+static void printk(const char *fmt,...){if(strstr(fmt,"I/O"))errors++;}
+static void panic(const char *s){(void)s;assert(!"kernel panic");}
+static int ssddev_write(sector_t lba,char *buf,ramdesc_t seg)
+{
+ (void)seg;assert(lba<16);writes++;
+ if(writes==fail_at)return 0;
+ memcpy(disk[lba],buf,512);
+ return writes!=uncertain_at; /* sector reached device, completion/flush failed */
+}
+static int ssddev_read(sector_t lba,char *buf,ramdesc_t seg)
+{(void)seg;reads++;assert(lba<16);memcpy(buf,disk[lba],512);return 1;}
+static void release_hook(void){releases++;}
+static const struct ssd_lifecycle ssd_lifecycle={0,NULL,release_hook};
+#include "kernel-functions.c"
+static void ll_rw_blk(int rw,struct buffer_head *b)
+{
+ struct request req={b->b_dev,(unsigned char)rw,RQ_ACTIVE,b->b_blocknr*2,2,b->data,0,b,NULL,0};
+ assert(!CURRENT);b->b_locked=1;add_request(&blk_dev[SSD_MAJOR],&req);
+ assert(!CURRENT && req.rq_status==RQ_INACTIVE && !b->b_locked);
+}
+static void setup(void)
+{
+ memset(buffers,0,sizeof(buffers));memset(disk,0x33,sizeof(disk));
+ writes=reads=errors=releases=fail_at=uncertain_at=0;
+ bh_lru=&buffers[0];bh_llru=&buffers[1];
+ buffers[0].b_next_lru=&buffers[1];buffers[1].b_prev_lru=&buffers[0];
+ for(unsigned i=0;i<2;i++) {
+  buffers[i].b_dev=MKDEV(SSD_MAJOR,1);buffers[i].b_blocknr=i;
+  buffers[i].b_dirty=buffers[i].b_uptodate=1;
+  memset(buffers[i].data,0x60+i,1024);
+ }
+ ssd_num_sects=16;ssd_initialized=1;ssd_part[0]=(struct hd_struct){0,16};
+ ssd_part[1]=(struct hd_struct){2,8};
+ blk_dev[SSD_MAJOR].request_fn=do_ssd_request;CURRENT=NULL;
+ access_count=1;lifecycle_busy=0;
+}
+int main(void)
+{
+ setup();assert(sys_sync()==0);assert(writes==4 && !errors);
+ assert(!buffers[0].b_dirty && buffers[0].b_uptodate);
+ assert(!memcmp(disk[2],buffers[0].data,1024));cases++;
+ /* Test first and second sectors of both queued blocks. */
+ for(unsigned at=1;at<=4;at++) {
+  for(unsigned uncertain=0;uncertain<2;uncertain++) {
+   setup();if(uncertain)uncertain_at=at;else fail_at=at;
+   assert(sys_sync()==0); /* Existing API: failure is logged, not returned. */
+   unsigned bad=at<=2?0:1;
+   assert(errors==1 && !buffers[bad].b_uptodate && !buffers[bad].b_dirty);
+   assert(buffers[1-bad].b_uptodate && !buffers[1-bad].b_dirty);
+   unsigned before=writes;assert(sys_sync()==0);assert(writes==before);
+   /* Check failed-sector bytes: ambiguous completion may have changed media. */
+   unsigned lba=at+1;
+   unsigned char expected=uncertain?(unsigned char)(0x60+bad):0x33;
+   for(unsigned j=0;j<512;j++)assert(disk[lba][j]==expected);
+   ssd_release(NULL,NULL);assert(releases==1 && !access_count && !lifecycle_busy);
+   assert(writes==before); /* final release neither retries nor reports failure */
+   cases++;
+  }
+ }
+ setup();buffers[1].b_dirty=0;buffers[0].b_dev=MKDEV(SSD_MAJOR,0);
+ fsync_dev(MKDEV(SSD_MAJOR,1));assert(!writes && buffers[0].b_dirty);cases++;
+ printf("PASS %u characterization cases: actual queue/SSD/end_request/sync/release; ASYNCIO=%d\n",cases,
+#ifdef CONFIG_ASYNCIO
+ 1
+#else
+ 0
+#endif
+ );
+ puts("REPRODUCED: failed writes leave a clean invalid buffer; sync returns zero; final release has no error result.");
+}
