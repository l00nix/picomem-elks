diff --git a/elks/arch/i86/drivers/block/picoblk-test.inc b/elks/arch/i86/drivers/block/picoblk-test.inc
new file mode 100644
index 00000000..2e6fc290
--- /dev/null
+++ b/elks/arch/i86/drivers/block/picoblk-test.inc
@@ -0,0 +1,51 @@
+/* Emulator ONLY. Never enable on physical hardware. Emulates the new wire
+ * service with the real protocol core, reading BIOS disk 0x81, never writing.
+ * This validates the ELKS driver/filesystem path, not physical USB transport.
+ */
+#include <linuxmt/biosparm.h>
+#include <linuxmt/genhd.h>
+#include "picoblk-test-core.c"
+static struct pmb_media test_media;
+static unsigned char test_request[32],test_reply[544],test_state=PMB_IDLE;
+static unsigned test_cursor,test_polls;
+static struct drive_infot test_geometry={130,63,16,512,HARDDISK};
+static int test_read(uint32_t lba,uint8_t *data)
+{
+ int err;
+ err=bios_disk_rw(BIOSHD_READ,1,0x81,lba/(16UL*63),
+                 (lba/63)%16,lba%63+1,DMASEG,0,&test_geometry);
+ if(err) return 0;
+ xms_fmemcpyw(data,KERNEL_DS,0,DMASEG,256);
+ return 1;
+}
+static unsigned char pmb_test_inb(unsigned port)
+{
+ if(!test_media.present) pmb_attach(&test_media,131040,512,0x1234,0x5678);
+ switch(port-CONFIG_PICOBLK_PORT) {
+ case 5:
+  if(test_state==PMB_BUSY && ++test_polls==2) {
+   pmb_execute(&test_media,test_request,test_reply,test_read);
+   test_cursor=0;test_state=PMB_DONE;
+  }
+  return test_state;
+ case 6:return PMB_IDENT;
+ case 7:if(test_state==PMB_DONE && test_cursor<544)return test_reply[test_cursor++];
+ }
+ return 0xff;
+}
+static void pmb_test_outb(unsigned char data,unsigned port)
+{
+ switch(port-CONFIG_PICOBLK_PORT) {
+ case 5:
+  if(data==PMB_BEGIN && test_state==PMB_IDLE){test_cursor=0;test_state=PMB_RX;}
+  else if(data==PMB_SUBMIT && test_state==PMB_RX && test_cursor==32){
+   test_polls=0;test_state=PMB_BUSY;
+  }else if(data==PMB_ACK && test_state==PMB_DONE)test_state=PMB_IDLE;
+  break;
+ case 7:if(test_state==PMB_RX && test_cursor<32)test_request[test_cursor++]=data;
+ }
+}
+#undef inb
+#undef outb
+#define inb pmb_test_inb
+#define outb pmb_test_outb
diff --git a/tests/block-write-errors/README.md b/tests/block-write-errors/README.md
new file mode 100644
index 00000000..dda9b752
--- /dev/null
+++ b/tests/block-write-errors/README.md
@@ -0,0 +1,27 @@
+# Buffered write-error characterization
+
+Run `python3 tests/block-write-errors/run.py` from the ELKS tree. Add
+`--base-core` to use queue, completion and buffer functions from the pinned
+upstream base while retaining the candidate SSD request dispatcher.
+
+The harness extracts kernel function bodies verbatim. Platform declarations,
+sector I/O, scheduling primitives, inode/superblock sync and buffer acquisition
+for a request are mocked. The real queue insertion, SSD sector loop,
+`end_request`, buffer sync/invalidation and final SSD release execute together.
+No disk device is opened and no kernel or firmware is installed.
+
+Ten cases run in each CONFIG_ASYNCIO configuration, with ASan/UBSan: successful
+writes, failure on either sector of either buffer, ambiguous completion after
+bytes reach the mock disk, repeat sync, final release, and device filtering.
+The asynchronous build checks that code path but does not simulate interrupts
+or concurrent writes. The fixture uses two-sector (1 KiB) buffers, not every FAT
+sector-size/cache configuration. Mounted-filesystem unmount is not executed.
+
+These are characterization assertions, not tests claiming a fix. Both current
+and pinned-base core behavior clear dirty state at queue insertion, mark a
+failed buffer not up to date, log an I/O error, return zero from `sys_sync`, and
+provide no error result from final release. Subsequent sync skips that clean
+invalid buffer. An ambiguous completion may already have changed sector bytes.
+
+Do not infer that a logged write error permits safe media removal, or that
+re-dirtying buffers alone supplies error propagation or safe retry policy.
diff --git a/tests/block-write-errors/run.py b/tests/block-write-errors/run.py
new file mode 100644
index 00000000..b6a9d7e4
--- /dev/null
+++ b/tests/block-write-errors/run.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Exercise unchanged kernel function bodies with mocked sectors, never hardware."""
+from pathlib import Path
+import re, subprocess, tempfile, hashlib, json, sys
+here = Path(__file__).resolve().parent
+root = here.parent.parent
+files = {
+    'block': root/'elks/arch/i86/drivers/block/ll_rw_blk.c',
+    'end': root/'elks/arch/i86/drivers/block/blk.h',
+    'ssd': root/'elks/arch/i86/drivers/block/ssd.c',
+    'buffer': root/'elks/fs/buffer.c',
+}
+
+def function(text, name):
+    # Match a definition, not calls/forward declarations. Bodies remain verbatim.
+    m = re.search(r'^([^\n;]*\b' + name + r'\([^;]*?\)\s*\n\{)', text, re.M)
+    if not m: raise RuntimeError('definition missing: '+name)
+    start = text.index('{', m.start())
+    # Mask comments and literals only for brace counting, preserving character offsets.
+    masked = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'',
+                    lambda x: ' '*len(x.group()), text, flags=re.S)
+    depth = 0
+    for i in range(start, len(text)):
+        if masked[i] == '{': depth += 1
+        elif masked[i] == '}':
+            depth -= 1
+            if not depth: return text[m.start():i+1]
+    raise RuntimeError('unterminated '+name)
+
+sources = {k:p.read_text() for k,p in files.items()}
+base = '052b4be698d9fb780ebdd9c9510ecdc4c2f9dd33'
+if '--base-core' in sys.argv:
+    for k in ('block','end','buffer'):
+        sources[k] = subprocess.check_output(['git','-C',str(root),'show',base+':'+str(files[k].relative_to(root))],text=True)
+
+order = [('buffer','mark_buffer_uptodate'),('buffer','unlock_buffer'),
+         ('end','end_request'),('block','add_request'),
+         ('ssd','ssd_io_complete'),('ssd','do_ssd_request'),
+         ('buffer','sync_buffers'),('buffer','fsync_dev'),('buffer','sys_sync'),
+         ('buffer','invalidate_buffers'),('ssd','ssd_invalidate'),('ssd','ssd_release')]
+bodies = '\n\n'.join(function(sources[k],n) for k,n in order)
+with tempfile.TemporaryDirectory(prefix='elks-write-errors-') as d:
+    p=Path(d);(p/'kernel-functions.c').write_text(bodies)
+    for asynchronous in [0,1]:
+        exe=p/('errors-'+str(asynchronous))
+        cmd=['cc','-std=c11','-Wall','-Wextra','-Werror','-Wno-unused-parameter',
+             '-Wno-unused-function','-Wno-unused-but-set-variable','-fsanitize=address,undefined','-g','-I'+d]
+        if asynchronous: cmd+=['-DCONFIG_ASYNCIO=1']
+        subprocess.run(cmd+[str(here/'test-errors.c'),'-o',str(exe)],check=True)
+        subprocess.run([str(exe)],check=True)
+print(json.dumps({'source_sha256':{str(p.relative_to(root)):hashlib.sha256(sources[k].encode()).hexdigest() for k,p in files.items()},
+                  'physical_io':False,'base_core':('--base-core' in sys.argv),'base_commit':base},indent=2))
