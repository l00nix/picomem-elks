index 00000000..de2ebe82
--- /dev/null
+++ b/tests/fat-fsinfo/test.c
@@ -0,0 +1,65 @@
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+#include <errno.h>
+typedef uint32_t __u32;
+#define MS_RDONLY 1
+struct super_block { int fat_bits; unsigned short fat_start; };
+#define MSDOS_SB(s) (s)
+struct msdos_boot_sector { unsigned char padding[14]; uint16_t reserved; unsigned char rest[32]; uint16_t info_sector; };
+struct buffer_head { int unused; };
+static union { uint32_t aligned[256]; unsigned char bytes[1024]; } disk[32];
+static struct buffer_head buffers[32];
+static int reads, refs, dirty, fail_sector, current_sector;
+static struct buffer_head *msdos_sread(struct super_block *s, unsigned short sector, void **data)
+{
+ (void)s; ++reads; assert(refs==0); assert(sector<32);
+ if (sector==fail_sector) return NULL;
+ current_sector=sector; ++refs; *data=disk[sector].bytes; return &buffers[sector];
+}
+static void unmap_brelse(struct buffer_head *bh) { assert(bh==&buffers[current_sector]); assert(refs==1); --refs; }
+static void mark_buffer_dirty(struct buffer_head *bh) { assert(refs==1); assert(bh==&buffers[current_sector]); assert(current_sector!=0); ++dirty; }
+#include "actual.inc"
+static void put(unsigned sector,unsigned offset,uint32_t value) { memcpy(disk[sector].bytes+offset,&value,4); }
+static void setup(unsigned sector)
+{
+ unsigned i; for(i=0;i<32;i++) memset(disk[i].bytes,0x5a,1024);
+ ((struct msdos_boot_sector *)disk[0].bytes)->info_sector=sector;
+ ((struct msdos_boot_sector *)disk[0].bytes)->reserved=32;
+ if(sector<32) { put(sector,0,0x41615252);put(sector,484,0x61417272);put(sector,508,0xaa550000);put(sector,488,100);put(sector,492,20); }
+ reads=refs=dirty=0;fail_sector=-1;
+}
+int main(void)
+{
+ struct super_block s={32,64}; unsigned char before[sizeof disk], expected[sizeof disk];
+ unsigned sector,case_no,cases=0; int flags,rc;
+ for(sector=1;sector<=3;sector+=2) {
+  for(case_no=0;case_no<14;case_no++) {
+   setup(sector); s.fat_bits=32; flags=0;
+   if(case_no==1) flags=MS_RDONLY;
+   if(case_no==2) s.fat_bits=12;
+   if(case_no==3) s.fat_bits=16;
