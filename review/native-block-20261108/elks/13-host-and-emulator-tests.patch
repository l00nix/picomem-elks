index 00000000..177b5d5f
--- /dev/null
+++ b/tests/fat-mirror/test.c
@@ -0,0 +1,91 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define FATPROC
+#define MSDOS_SB(s) (&(s)->fat)
+#define SECTOR_BITS_SB(s) ((s)->bits)
+#define SECTOR_SIZE_SB(s) (1u << (s)->bits)
+#define debug_fat(...) ((void)0)
+#define buffer_blocknr(b) ((b)->number)
+#define printk(...) ((void)0)
+typedef int32_t cluster_t;
+typedef uint32_t sector_t;
+struct super_block { struct { uint16_t fat_start,fat_length; uint8_t fats,fat_bits; } fat; unsigned bits; };
+struct buffer_head { unsigned number,refs,dirty; };
+static unsigned char disk[262144],expected[sizeof(disk)];
+static struct buffer_head buffers[sizeof(disk)/1024];
+static int fail_sector;
+static unsigned reads,live,maxlive;
+static struct buffer_head *msdos_sread(struct super_block *s,sector_t sec,void **data)
+{
+ reads++;
+ if ((int)sec==fail_sector)return NULL;
+ unsigned byte=sec<<s->bits;assert(byte+SECTOR_SIZE_SB(s)<=sizeof(disk));
+ struct buffer_head *bh=&buffers[byte/1024];bh->number=byte/1024;
+ bh->refs++;live++;if(live>maxlive)maxlive=live;
+ *data=disk+byte;return bh;
+}
+static void mark_buffer_dirty(struct buffer_head *b){assert(b->refs);b->dirty=1;}
+static void unmap_brelse(struct buffer_head *b){assert(b&&b->refs&&live);b->refs--;live--;}
+#include "fat-under-test.c"
+static void reset(void)
+{
+ for(unsigned i=0;i<sizeof(disk);i++)disk[i]=(unsigned char)(i*17+3);
+ memset(buffers,0,sizeof(buffers));fail_sector=-1;reads=live=maxlive=0;
+}
+static unsigned offset(unsigned bits,unsigned entry){return bits==12?entry+entry/2:entry*(bits/8);}
+static void set(unsigned char *p,unsigned bits,unsigned entry,uint32_t value)
+{
+ unsigned n=offset(bits,entry);
+ if(bits==12){if(entry&1){p[n]=(p[n]&15)|((value&15)<<4);p[n+1]=value>>4;}else{p[n]=value;p[n+1]=(p[n+1]&240)|((value>>8)&15);}}
+ else for(unsigned i=0;i<bits/8;i++)p[n+i]=value>>(i*8);
+}
+static unsigned char *table(struct super_block *s,unsigned char *base,unsigned copy)
+{return base+((s->fat.fat_start+copy*s->fat.fat_length)<<s->bits);}
+static void released(void){assert(live==0);for(unsigned i=0;i<sizeof(buffers)/sizeof(*buffers);i++)assert(!buffers[i].refs);assert(maxlive<=2);}
+int main(void)
+{
+ unsigned cases=0;
+ for(unsigned bits=12;bits<=32;bits=bits==12?16:bits==16?32:33){
+#ifdef FAT_BITS_32
+  if(bits!=32)continue;
+#endif
+  for(unsigned sectorbits=9;sectorbits<=10;sectorbits++)for(unsigned copies=1;copies<=3;copies++){
+   struct super_block s={{1,16,copies,bits},sectorbits};
+   unsigned entries[]={2,3,127,255,341,682,683,1365};
+   for(unsigned j=0;j<sizeof(entries)/sizeof(*entries);j++)for(unsigned v=0;v<3;v++){
+    unsigned entry=entries[j];uint32_t value=v==0?0:v==1?123:bits==12?0xff8:bits==16?0xfff8:0xffffff8;
+    reset();for(unsigned c=0;c<copies;c++)set(table(&s,disk,c),bits,entry,77+c);
+    memcpy(expected,disk,sizeof(disk));for(unsigned c=0;c<copies;c++)set(table(&s,expected,c),bits,entry,value);
+    assert(fat_access(&s,entry,value)==77);assert(!memcmp(expected,disk,sizeof(disk)));released();
+    unsigned before=reads;assert(fat_access(&s,entry,-1)==(v==2?-1:(int32_t)value));released();
+    assert(reads-before<=2);cases++;
+   }
+   /* Read-only access must never fetch a mirror or dirty any buffer. */
+   reset();set(table(&s,disk,0),bits,2,88);memcpy(expected,disk,sizeof(disk));fail_sector=s.fat.fat_start+s.fat.fat_length;
+   assert(fat_access(&s,2,-1)==88);assert(reads==1&&!memcmp(expected,disk,sizeof(disk)));released();
+   for(unsigned i=0;i<sizeof(buffers)/sizeof(*buffers);i++)assert(!buffers[i].dirty);
+   for(unsigned failedcopy=0;failedcopy<copies;failedcopy++){
+    reset();for(unsigned c=0;c<copies;c++)set(table(&s,disk,c),bits,2,77+c);
+    memcpy(expected,disk,sizeof(disk));for(unsigned c=0;c<failedcopy;c++)set(table(&s,expected,c),bits,2,123);
+    fail_sector=s.fat.fat_start+failedcopy*s.fat.fat_length;
+    assert(fat_access(&s,2,123)==0);released();assert(!memcmp(expected,disk,sizeof(disk)));cases++;
+   }
+  }
+ }
+#ifndef FAT_BITS_32
+ /* FAT12 sector straddles: two reads can share one 1K buffer or use two. */
+ for(unsigned start=1;start<=2;start++)for(unsigned entry=341;entry<=682;entry+=341){
+  struct super_block s={{start,3,3,12},9};
+  for(unsigned failedcopy=0;failedcopy<3;failedcopy++)for(unsigned half=0;half<2;half++){
+   reset();for(unsigned c=0;c<3;c++)set(table(&s,disk,c),12,entry,77+c);
+   memcpy(expected,disk,sizeof(disk));for(unsigned c=0;c<failedcopy;c++)set(table(&s,expected,c),12,entry,123);
+   fail_sector=start+failedcopy*3+(offset(12,entry)>>9)+half;
+   assert(fat_access(&s,entry,123)==0);released();assert(!memcmp(expected,disk,sizeof(disk)));cases++;
+  }
+ }
+#endif
+ puts("PASS actual fat_access: per-copy entry writes, original return value, neighbor preservation, 512/1024 sectors, bounded mappings and read-failure cleanup");
+ printf("%u cases\n",cases);
+}
