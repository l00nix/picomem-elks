diff --git a/elks/arch/i86/drivers/char/ppc-core.h b/elks/arch/i86/drivers/char/ppc-core.h
new file mode 100644
index 00000000..8f2040bd
--- /dev/null
+++ b/elks/arch/i86/drivers/char/ppc-core.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * PPC512/640 display beta 3. Hardware operations shared by command and kernel.
+ * Verified PPC firmware only; no BIOS code or timing tables are distributed here.
+ */
+#ifndef PPC_CORE_H
+#define PPC_CORE_H
+#ifndef PPC_FN
+#define PPC_FN
+#endif
+#define PPC_OP 0x3de
+#define PPC_BDA_OP 0x48f
+#define PPC_BDA_CONTRAST 0x412
+#define PPC_BIOS_SEG 0xfc00
+#define PPC_NMI_OFF 0x0b41
+/* READ8/READ16(segment,offset), WRITE8, IN8, OUT8 supplied by caller. */
+static int PPC_FN ppc_vector_ok(void)
+{
+    unsigned seg = READ16(0, 10), off = READ16(0, 8);
+    /* Accept aliases of physical FCB41, including F000:CB41. */
+    return (((unsigned long)seg << 4) + off) == 0xfcb41UL;
+}
+
+static int PPC_FN ppc_rom_ok(void)
+{
+    unsigned i, bit, crc = 0xffff;
+    if (READ16(PPC_BIOS_SEG, 0x16) != 0x4d41 ||
+        READ16(PPC_BIOS_SEG, 0x18) != 0x5453 ||
+        READ16(PPC_BIOS_SEG, 0x1a) != 0x4152) return 0;
+    for (i = 0; i < 0x4000; ++i) {
+        crc ^= (unsigned)READ8(PPC_BIOS_SEG, i) << 8;
+        for (bit = 0; bit < 8; ++bit)
+            crc = (unsigned short)((crc << 1) ^ ((crc & 0x8000) ? 0x1021 : 0));
+    }
+    /* F18A: physical PPC dump; display routines/tables match the V2 archive. */
+    return crc == PPC_ROM_CRC || crc == 0xf18a;
+}
+
+/* Return 0 only for the firmware-managed, built-in CGA adapter. */
+static int PPC_FN ppc_ready(void)
+{
+    unsigned char op = READ8(0, PPC_BDA_OP);
+    unsigned char ctl, mode = READ8(0, 0x449);
+    if (!ppc_vector_ok()) return 3;
+    if ((op & 0xc6) != 0x80 || (IN8(PPC_OP) & 0xc7) != (op & 0xc7)) return 4;
+    if (mode > 6) return 5;
+    ctl = IN8(0x3d8);
+    /* Require a standard BIOS text/graphics layout, not 160x100 tricks. */
+    if (mode < 4) {
+        if ((ctl & 0x43) != (mode >= 2 ? 1 : 0)) return 5;
+    } else if (!(ctl & 2) || ((ctl & 0x10) != (mode == 6 ? 0x10 : 0))) return 5;
+    return 0;
+}
+
+/* Caller disables maskable IRQs. ROM NMI remains enabled and owns timings.
+ * LCD.COM's behavior: change BDA 48F, write standard R1/R6 values. The ROM
+ * traps these and reloads LCD/CRT timings. No mode reset, no VRAM writes,
+ * no cursor/page reset. Firmware updates BDA 48E as part of the operation.
+ */
+static int PPC_FN ppc_select(unsigned target)
+{
+    unsigned char ctl, old, index;
+    int rc = ppc_ready();
+    if (target > 1) return 2;
+    if (rc) return rc;
+    old = READ8(0, PPC_BDA_OP);
+    if ((old & 1) == target) return 0;
+    ctl = IN8(0x3d8);
+    /* Index readback also acknowledges traps: reject pending work first. */
+    index = IN8(0x3dd);
+    if (index & 0xe0) return 6;
+    WRITE8(0, PPC_BDA_OP, (old & 0xfe) | target);
+    OUT8(0x3d4, 1);
+    OUT8(0x3d5, (ctl & 2) ? 40 : ((ctl & 1) ? 80 : 40));
+    OUT8(0x3d4, 6);
+    OUT8(0x3d5, (ctl & 2) ? 100 : 25);
+    OUT8(0x3d4, index & 0x1f);
+    return (IN8(PPC_OP) & 0xc7) == (((old & 0xfe) | target) & 0xc7) ? 0 : 7;
+}
+
+/* LCD.COM's right-Alt action: change the firmware text-mapping preference,
+ * then rewrite CGA mode control so the ROM NMI applies bit 7. This is not
+ * the analogue contrast wheel. Keep output selection and video mode intact.
+ * Caller disables IRQs, with NMI enabled, as for ppc_select. */
+static int PPC_FN ppc_contrast(unsigned target)
+{
+    unsigned char old, ctl, index, op;
+    int rc = ppc_ready();
+    if (target > 1) return 2;
+    if (rc) return rc;
+    if (READ8(0, 0x449) > 3) return 8;
+    old = READ8(0, PPC_BDA_CONTRAST);
+    ctl = IN8(0x3d8);
+    if ((old >> 7) == target && (ctl >> 7) == target) return 0;
+    index = IN8(0x3dd);
+    if (index & 0xe0) return 6;
+    op = READ8(0, PPC_BDA_OP);
+    WRITE8(0, PPC_BDA_CONTRAST, (old & 0x7f) | (target << 7));
+    OUT8(0x3d8, ctl);
+    OUT8(0x3d4, index & 0x1f);
+    return (IN8(0x3d8) >> 7) == target &&
+           (IN8(PPC_OP) & 0xc7) == (op & 0xc7) ? 0 : 7;
+}
+#endif
diff --git a/elks/arch/i86/drivers/char/ppc-display.c b/elks/arch/i86/drivers/char/ppc-display.c
new file mode 100644
index 00000000..d7bf8372
--- /dev/null
+++ b/elks/arch/i86/drivers/char/ppc-display.c
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Optional PPC display support. Keep the ROM NMI service, and observe key
+ * events without swallowing any bytes (including in graphics/raw mode).
+ */
+#ifndef PPC_DISPLAY_HOST_TEST
+#include <linuxmt/config.h>
+#include <linuxmt/init.h>
+#include <linuxmt/kernel.h>
+#include "ppc-hw.h"
+#define PPC_FN FARPROC
+#include "ppc-core.h"
+#endif
+
+static int ppc_active;
+static unsigned char extended, scroll_down, scroll_on, ctrl_down, alt_down;
+
+int INITPROC ppc_display_init(void)
+{
+    if (!ppc_rom_ok() || ppc_ready()) return 0;
+    ppc_active = 1;
+    printk("PPC display beta3: ScrollLock + right Ctrl/Alt\n");
+    return 1;
+}
+
+void FARPROC ppc_display_key(unsigned code)
+{
+    unsigned released, key, flags;
+    if (!ppc_active) return;
+    if (code == 0xe0) { extended = 1; return; }
+    released = code & 0x80;
+    key = code & 0x7f;
+    if (!extended && key == 0x46) {
+        if (!released) scroll_down = 1;
+        else if (scroll_down) { scroll_on ^= 1; scroll_down = 0; }
+    }
+    if (extended && key == 0x1d) {
+        if (released) ctrl_down = 0;
+        else if (!ctrl_down) {
+            ctrl_down = 1;
+            if (scroll_on) {
+                /* ELKS enables IRQs inside do_IRQ; serialize the two writes. */
+                LOCK(flags);
+                ppc_select(!(READ8(0,PPC_BDA_OP) & 1));
+                UNLOCK(flags);
+            }
+        }
+    }
+    if (extended && key == 0x38) {
+        if (released) alt_down = 0;
+        else if (!alt_down) {
+            alt_down = 1;
+            if (scroll_on) {
+                LOCK(flags);
+                ppc_contrast(!(READ8(0, PPC_BDA_CONTRAST) & 0x80));
+                UNLOCK(flags);
+            }
+        }
+    }
+    extended = 0;
+}
diff --git a/elks/arch/i86/drivers/char/ppc-hw.h b/elks/arch/i86/drivers/char/ppc-hw.h
new file mode 100644
index 00000000..195e56ef
--- /dev/null
+++ b/elks/arch/i86/drivers/char/ppc-hw.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PPC_HW_H
+#define PPC_HW_H
+#ifndef __ia16__
+#error Use the IA16 compiler for the hardware build
+#endif
+#define PPC_ROM_CRC 0x154e
+#define PPC_PTR(s,o) ((volatile unsigned char __far *)(((unsigned long)(s)<<16)|(unsigned)(o)))
+#define READ8(s,o) (*PPC_PTR(s,o))
+#define READ16(s,o) (*(volatile unsigned short __far *)PPC_PTR(s,o))
+#define WRITE8(s,o,v) (READ8(s,o)=(v))
+static __inline__ __attribute__((always_inline)) unsigned char ppc_in(unsigned port)
+{
+    unsigned char value;
+    __asm__ volatile("inb %%dx,%%al" : "=Ral"(value) : "d"(port) : "memory");
+    return value;
+}
+static __inline__ __attribute__((always_inline)) void ppc_out(unsigned port, unsigned char value)
+{
+    __asm__ volatile("outb %%al,%%dx" :: "Ral"(value), "d"(port) : "memory");
+}
+#define IN8(p) ppc_in(p)
+#define OUT8(p,v) ppc_out(p,v)
+#define LOCK(f) __asm__ volatile("pushf; pop %0; cli" : "=r"(f) :: "memory","cc")
+#define UNLOCK(f) __asm__ volatile("push %0; popf" :: "r"(f) : "memory","cc")
+#endif
