diff --git a/elks/arch/i86/drivers/block/ssd.c b/elks/arch/i86/drivers/block/ssd.c
index 78dd1b82..2d4cf66b 100644
--- a/elks/arch/i86/drivers/block/ssd.c
+++ b/elks/arch/i86/drivers/block/ssd.c
@@ -30,6 +30,29 @@ jiff_t ssd_timeout;
 sector_t ssd_num_sects;         /* max # sectors on SSD device */
 char ssd_initialized;
 static int access_count;
+static int lifecycle_busy;
+#ifdef CONFIG_SSD_PARTITIONS
+#define SSD_MINORS 8
+static struct hd_struct ssd_part[SSD_MINORS];
+static struct gendisk ssd_disk = {
+    SSD_MAJOR, "ssd", 3, SSD_MINORS, 1, ssd_part, 1, NULL
+};
+#else
+#define SSD_MINORS 1
+#endif
+
+static void ssd_invalidate(void)
+{
