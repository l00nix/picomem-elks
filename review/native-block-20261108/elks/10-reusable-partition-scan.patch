+/* Scan a drive whose whole-device entry already contains its exact capacity.
+ * Return -1 on an unreadable MBR, 0 for no MBR, 1 for a parsed MBR. Partition
+ * offsets/counts remain subject to the caller's device-capacity checks. */
+int GENPROC scan_partitions(struct gendisk *hd, unsigned int drive)
+{
+    unsigned int first = drive << hd->minor_shift, i;
+
+    for (i = 1; i < (unsigned int)hd->max_partitions; ++i) {
+        hd->part[first + i].start_sect = NOPART;
+        hd->part[first + i].nr_sects = 0;
+    }
+    return check_partition(hd, MKDEV(hd->major, first));
+}
