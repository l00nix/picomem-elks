+/* Accept only a complete 8.3 alias: msdos_format_name alone truncates. */
+static int FATPROC msdos_format_alias(const char *name, int len, char *alias)
+{
+	int i, base = 0, ext = -1;
+	unsigned char c;
+
+	if (len < 1 || len > 12) return -ENOENT;
+	if (get_fs_byte(name) == '.' &&
+	    (len == 1 || (len == 2 && get_fs_byte(name+1) == '.')))
+		return msdos_format_name(name, len, alias);
+	for (i = 0; i < len; i++) {
+		c = get_fs_byte(name+i);
+		if (c == '.') {
+			if (!base || ext >= 0) return -ENOENT;
+			ext = 0;
+		} else {
+			if (c <= ' ') return -ENOENT;
+			if (ext < 0) {
+				if (++base > 8) return -ENOENT;
+			} else if (++ext > 3) return -ENOENT;
+		}
+	}
+	if (ext == 0) return -ENOENT;
+	return msdos_format_name(name, len, alias);
+}
