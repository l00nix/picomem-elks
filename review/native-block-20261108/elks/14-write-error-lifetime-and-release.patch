diff --git a/elks/arch/i86/drivers/block/ll_rw_blk.c b/elks/arch/i86/drivers/block/ll_rw_blk.c
index c381934e..8f2e127c 100644
--- a/elks/arch/i86/drivers/block/ll_rw_blk.c
+++ b/elks/arch/i86/drivers/block/ll_rw_blk.c
@@ -43,6 +43,36 @@ static struct request all_requests[NR_REQUEST];
 /* current request and function pointer for each block device handler */
 struct blk_dev_struct blk_dev[MAX_BLKDEV];      /* initialized by blk_dev_init() */
 
+/* Sticky write failures, one bit per major/minor. Cleared only by reboot.
+ * Buffer reuse and later successful I/O must not hide an earlier failure. */
+static unsigned char write_errors[MAX_BLKDEV][32];
+
+void FARPROC blk_write_error(kdev_t dev)
+{
+    flag_t flags;
+
+    if (MAJOR(dev) >= MAX_BLKDEV) return;
+    save_flags(flags);
+    clr_irq();
+    write_errors[MAJOR(dev)][MINOR(dev) >> 3] |= 1 << (MINOR(dev) & 7);
+    restore_flags(flags);
+}
+
+int FARPROC blk_write_error_status(kdev_t dev)
+{
+    unsigned int major, byte;
+
+    if (dev) {
+        if (MAJOR(dev) >= MAX_BLKDEV) return -EIO;
+        return (write_errors[MAJOR(dev)][MINOR(dev) >> 3] &
+                (1 << (MINOR(dev) & 7))) ? -EIO : 0;
+    }
+    for (major = 0; major < MAX_BLKDEV; ++major)
+        for (byte = 0; byte < 32; ++byte)
+            if (write_errors[major][byte]) return -EIO;
+    return 0;
+}
+
 /* return hardware sector size for passed device */
 int get_sector_size(kdev_t dev)
 {
