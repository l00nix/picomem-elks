 option(PM_RAW_USB_RO "Experimental exclusive raw USB read-only interface" OFF)
 if(PM_RAW_USB_RO)
     add_compile_definitions(PM_RAW_USB_RO=1 PICO_STACK_SIZE=0x1000 PICO_CORE1_STACK_SIZE=0x800)
 endif()
 
+option(PM_RAW_USB_RP2_COMPARE "LOCAL ONLY: upstream RP2 controller; sector writes blocked by default" OFF)
+if(PM_RAW_USB_RP2_COMPARE)
+    if(NOT PM_RAW_USB_RW_LAB OR NOT PICO_BOARD STREQUAL "pimoroni_pico_plus2_rp2350")
+        message(FATAL_ERROR "RP2 comparison requires RP2350 and raw ABI2 laboratory mode")
+    endif()
+    add_compile_definitions(PM_RAW_USB_RP2_COMPARE=1)
