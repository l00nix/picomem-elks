+    if(NOT PM_RAW_USB_CSW_RECOVERY OR NOT PM_RAW_USB_RP2_COMPARE OR NOT PM_RAW_USB_RW_LAB)
+        message(FATAL_ERROR "Recovered writes require raw ABI2, RP2 comparison and CSW recovery")
+    endif()
+    add_compile_definitions(PM_RAW_USB_RECOVERED_WRITE=1)
+endif()
+
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_CXX_STANDARD 17)
 
