 cmake_minimum_required(VERSION 3.13)
 
+option(PM_RAW_USB_RW_LAB "LOCAL ONLY: experimental raw USB read/write ABI 2" OFF)
+option(PM_RAW_USB_EMPTY_CACHE_WT "LOCAL ONLY: assume write-through for two valid empty cache replies" OFF)
+if(PM_RAW_USB_EMPTY_CACHE_WT)
+    if(NOT PM_RAW_USB_RW_LAB)
+        message(FATAL_ERROR "Empty-cache write-through requires PM_RAW_USB_RW_LAB")
