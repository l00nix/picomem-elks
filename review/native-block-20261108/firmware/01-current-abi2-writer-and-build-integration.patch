+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PM_RAW_WRITER_H
+#define PM_RAW_WRITER_H
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+enum pmw_result { PMW_OK, PMW_DENIED, PMW_STALE, PMW_BUSY, PMW_IO, PMW_FAULT };
+/* Local, unintegrated candidate. One USB/core context owns this singleton.
+ * Requires exclusive raw ownership, LUN 0, patched TinyUSB completion evidence.
+ * Attach generations must increase without wrap until firmware restart.
+ * Board glue supplies time/pump and forwards MSC attach/detach notifications.
+ * There is intentionally no reset API: fault recovery requires controller and
+ * firmware restart, so a late DMA cannot target reused transfer storage. */
+struct pmw_info {
+    uint32_t generation, capacity;
+    bool present, prepared, writable, fault, dirty;
+};
+uint32_t pmw_claim_trace(void); /* Frozen timeout observation only. */
+uint32_t pmw_claim_counts(void); /* Diagnostic only; packed count/residue. */
+uint8_t pmw_claim_error(void); /* Serialized USB context; diagnostic only. */
+void pmw_info(struct pmw_info *out); /* Same serialized USB context. */
+uint32_t pmw_now_us(void);
+void pmw_pump(void);
+int pmw_attach(uint8_t addr, uint32_t generation);
+void pmw_detach(uint8_t addr);
+int pmw_claim(uint32_t generation, bool writable);
+int pmw_prepare(uint32_t generation); /* Writable claim shorthand. */
+int pmw_read(uint32_t generation, uint32_t lba, void *data, size_t length);
+int pmw_write(uint32_t generation, uint32_t lba, const void *data, size_t length);
+int pmw_flush(uint32_t generation);
+int pmw_release(uint32_t generation);
+#endif
